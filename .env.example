# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# HuggingFace token (read scope is enough). Required for pyannote diarization.
# Get one at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# Basic auth gate. Leaving either blank disables auth (local-only mode).
# Set these before exposing the app over a tunnel.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
