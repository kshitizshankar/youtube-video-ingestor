# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# HuggingFace token (read scope is enough). Required for pyannote diarization.
# Get one at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# Basic auth gate. Leaving both USER + PASS blank disables auth
# (local-only mode). Set these before exposing the app over a tunnel.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Optional: extra accounts as comma-separated user:pass pairs.
# Example: BASIC_AUTH_USERS=alice:applesauce,bob:bluejay42
BASIC_AUTH_USERS=

# yt-dlp cookie source — use to bypass YouTube's bot-check challenge.
# YTDLP_COOKIES_BROWSER = chrome|firefox|edge|brave|chromium|opera|vivaldi|safari
# YTDLP_COOKIES_FILE    = path to a cookies.txt exported from a browser
# Leave blank for anonymous (works for public/unguarded videos).
YTDLP_COOKIES_BROWSER=
YTDLP_COOKIES_FILE=
