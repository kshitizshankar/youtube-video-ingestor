{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value_prop",
    "narrative_summary",
    "takeaways",
    "chapters",
    "highlights",
    "check_screen_candidates"
  ],
  "properties": {
    "value_prop": {
      "type": "string",
      "description": "1-3 sentences. What a viewer walks away with from THIS video."
    },
    "narrative_summary": {
      "type": "string",
      "description": "Multi-paragraph, faithful, story-like retelling. Preserves the arc, reasoning moves, and asides. Not compressed."
    },
    "takeaways": {
      "type": "array",
      "description": "6-10 crisp declarative single-sentence lessons.",
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "description": "6-15 TOC entries. First start MUST be 0.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "title", "note"],
        "properties": {
          "start": { "type": "number" },
          "title": { "type": "string" },
          "note": {
            "type": "string",
            "description": "One sentence: what actually happens in this section."
          }
        }
      }
    },
    "highlights": {
      "type": "array",
      "description": "10-20 'easy to miss' moments with verbatim quotes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "speaker", "quote", "reason"],
        "properties": {
          "start": { "type": "number" },
          "end": { "type": "number" },
          "speaker": { "type": ["string", "null"] },
          "quote": {
            "type": "string",
            "description": "Direct verbatim substring from a transcript segment."
          },
          "reason": {
            "type": "string",
            "description": "Phrase as 'easy to miss because ___' or 'the non-obvious point is ___'. Not generic."
          }
        }
      }
    },
    "check_screen_candidates": {
      "type": "array",
      "description": "0-30 transcript moments where the audio alone is insufficient and the user should look at the screen.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t_sec",
          "segment_id",
          "trigger_text",
          "signal",
          "what_i_expect_to_see",
          "priority"
        ],
        "properties": {
          "t_sec": {
            "type": "number",
            "description": "Must match a real segment.start in transcript.json."
          },
          "segment_id": {
            "type": "integer",
            "description": "Must match that segment's id."
          },
          "trigger_text": {
            "type": "string",
            "description": "The short phrase from the segment that triggered the flag."
          },
          "signal": {
            "type": "string",
            "enum": [
              "deictic_reference",
              "code_on_screen",
              "diagram_drawn",
              "matrix_math_shown",
              "figure_reference",
              "animation_or_transition"
            ]
          },
          "what_i_expect_to_see": {
            "type": "string",
            "description": "Short guess at what is on screen at this moment."
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    }
  }
}
